<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CatdbNativeName Condition="$([MSBuild]::IsOSPlatform('Windows'))">newdbms.dll</CatdbNativeName>
    <CatdbNativeName Condition="$([MSBuild]::IsOSPlatform('Linux'))">libnewdbms.so</CatdbNativeName>
    <CatdbNativeName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libnewdbms.dylib</CatdbNativeName>
    <CatdbNativePath Condition="'$(CatdbNativePath)' == ''">$(MSBuildThisFileDirectory)../../target/release/$(CatdbNativeName)</CatdbNativePath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../NewDbmsDatabase.cs" Link="Native/NewDbmsDatabase.cs" />
    <Content Include="$(CatdbNativePath)" Link="$(CatdbNativeName)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireCatdbNative" BeforeTargets="PrepareForBuild" Condition="!Exists('$(CatdbNativePath)')">
    <Error Text="The catdb native library is missing. Run cargo build --locked --release --lib at the repository root or set CatdbNativePath to the built library." />
  </Target>
</Project>
