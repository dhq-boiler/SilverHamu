<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>SilverHamu.Client</PackageId>
    <Authors>dhq_boiler and contributors</Authors>
    <Description>.NET client for the silverhamu TCP service with binary keys and values, durable writes, transactions and TLS account authentication.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/dhq-boiler/catdb</RepositoryUrl>
    <PackageProjectUrl>https://github.com/dhq-boiler/catdb</PackageProjectUrl>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
