<Project>
  <PropertyGroup>
    <SilverHamuNativePath Condition="'$(SilverHamuNativePath)' == ''">$(MSBuildThisFileDirectory)..\target\release\newdbms.dll</SilverHamuNativePath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\dotnet\NewDbmsDatabase.cs" Link="Native\NewDbmsDatabase.cs" />
    <Content Include="$(SilverHamuNativePath)" Link="newdbms.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireSilverHamuNative" BeforeTargets="PrepareForBuild" Condition="!Exists('$(SilverHamuNativePath)')">
    <Error Text="silverhamu native DLL is missing. Run scripts/build-owner-native.ps1 first, or set SilverHamuNativePath to a compatible x64 newdbms.dll." />
  </Target>
</Project>
